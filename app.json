{
  "expo": {
    "name": "hairlog",
    "slug": "hairlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hairlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yuonhirose.hairlog",
      "infoPlist": {
        "NSCameraUsageDescription": "髪型の写真を撮影するためにカメラを使用します。写真は端末内にのみ保存され、外部には送信されません。",
        "NSPhotoLibraryUsageDescription": "過去の髪型の写真を記録に追加するために写真ライブラリを使用します。選んだ写真は端末内にのみ保存されます。",
        "NSPhotoLibraryAddUsageDescription": "記録した髪型の写真をカメラロールに保存するために使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121412",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F9F7",
          "dark": {
            "backgroundColor": "#141821"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "過去の髪型の写真を記録に追加するために写真ライブラリを使用します。選んだ写真は端末内にのみ保存されます。",
          "cameraPermission": "髪型の写真を撮影するためにカメラを使用します。写真は端末内にのみ保存され、外部には送信されません。",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "記録した髪型の写真をカメラロールに保存するために使用します。",
          "savePhotosPermission": "記録した髪型の写真をカメラロールに保存するために使用します。",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6E8B72"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "owner": "yuon",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8513c2f6-cd83-445d-9564-39bc7afc08b8"
      }
    }
  }
}
